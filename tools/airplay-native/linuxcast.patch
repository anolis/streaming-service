 		}
 	}
 }
+
+// A silent receiver must not hold the sender until its process watchdog fires.
+func TestLinuxcastCloseBoundsUnresponsiveControl(t *testing.T) {
+	for _, feedback := range []bool{false, true} {
+		name := "teardown"
+		if feedback {
+			name = "feedback"
+		}
+		t.Run(name, func(t *testing.T) {
+			sender, receiver := net.Pipe()
+			defer sender.Close()
+			defer receiver.Close()
+			if !feedback {
+				go func() { _, _ = io.Copy(io.Discard, receiver) }()
+			}
+			client := &AirPlayClient{conn: sender}
+			session := &MirrorSession{client: client, sessionURI: "rtsp://receiver/session"}
+			if feedback {
+				session.startWorker(func() {
+					_, _, _ = client.rtspRequest("POST", "/feedback", "", nil, nil)
+				})
+			}
+			done := make(chan error, 1)
+			go func() { done <- session.Close() }()
+			select {
+			case <-done:
+			case <-time.After(2 * time.Second):
+				t.Fatal("Close blocked on an unresponsive receiver")
+			}
+			if err := session.Close(); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
