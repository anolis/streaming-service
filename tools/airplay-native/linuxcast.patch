+// Regression for the linuxcast PIN prompt ordering: M1/M2 happen before the
+// credential prompt, and Pair must reuse that challenge rather than request one.
+func TestLinuxcastPINChallengeReuse(t *testing.T) {
+	server, client, ctx := newReceiverServerTestPair(t, ReceiverConfig{
+		Profile: ReceiverProfileModern, Auth: ReceiverAuthPIN, Code: "4827",
+	})
+	if err := client.StartPINDisplay(); err != nil {
+		t.Fatal(err)
+	}
+	if err := client.PreparePINPairing(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if got := server.Stats().PairSetup; got != 1 {
+		t.Fatalf("requests before prompt = %d, want 1", got)
+	}
+	if err := client.Pair(ctx, "4827"); err != nil {
+		t.Fatal(err)
+	}
+	if got := server.Stats().PairSetup; got != 3 {
+		t.Fatalf("requests after pairing = %d, want 3 (no second M1)", got)
+	}
